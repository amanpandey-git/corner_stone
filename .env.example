# Copy to .env and fill in. .env is gitignored: never commit it, never paste keys into chat or logs.
# Stage 2 LLM providers (the one in use is chosen by llm.provider in config.yaml).
GROQ_API_KEY=            # https://console.groq.com/keys (free tier, rate-limited)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey (Google AI Studio, free tier, rate-limited)
# HF_HOME=D:\hf_cache    # optional: where the embedding / reranker models are cached
